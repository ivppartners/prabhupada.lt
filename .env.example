# Pavyzdinė konfigūracija (nekeliama į git kaip .env su realiais slaptažodžiais)
# AUDIO_PATH rekomenduojama nustatyti absoliučiu keliu (ypač kai audio katalogas yra mountintas volume).
# Jei pateiksi reliatyvų kelią, aplikacija jį išspręs į absoliutų per `path.resolve(...)`.
AUDIO_PATH="./audio"

# Produkcijoje už Nginx reverse proxy rekomenduojama klausyti tik 127.0.0.1
HOST=127.0.0.1
PORT=4001

POSTGRES_USER=prabhupada
POSTGRES_PASSWORD=change-me
POSTGRES_DB=prabhupada
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSL=false

# Pasirinktinai: upload dydžio limitas baitais (pvz. 500MB)
# MAX_UPLOAD_BYTES=524288000
